---
import { site } from "../config/site";
---

<dialog
  id="video-dialog"
  aria-labelledby="video-title"
  class="m-auto max-h-[92vh] w-[min(94vw,980px)] overflow-y-auto rounded-2xl border border-outline-variant/50 bg-surface-container-lowest p-4 text-on-surface shadow-2xl sm:p-6"
>
  <div class="flex items-start justify-between gap-4 pb-4">
    <div class="flex flex-col gap-1">
      <span class="font-label-sm text-label-sm font-bold uppercase tracking-wider text-primary">Demo en video</span>
      <h2 id="video-title" class="font-headline-sm text-headline-sm font-bold text-on-surface">FarmSys POS en acción</h2>
    </div>
    <button
      type="button"
      data-close-video
      class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-surface-container text-on-surface-variant transition-colors hover:bg-surface-container-high hover:text-on-surface"
    >
      <span class="material-symbols-outlined text-[20px]" aria-hidden="true">close</span>
      <span class="sr-only">Cerrar video</span>
    </button>
  </div>

  <div id="video-player" class="relative aspect-video overflow-hidden rounded-xl bg-on-background">
    <video
      id="demo-video"
      class="h-full w-full object-cover"
      playsinline
      preload="none"
      poster={site.video.poster}
      width="1280"
      height="720"
    >
      <source src={site.video.src} type="video/mp4" />
      Tu navegador no soporta video HTML5.
    </video>
    <button
      type="button"
      id="video-play"
      class="absolute inset-0 flex items-center justify-center bg-on-background/25 transition-colors hover:bg-on-background/35"
      aria-label="Reproducir video demo"
    >
      <span class="flex h-16 w-16 items-center justify-center rounded-full bg-primary text-on-primary shadow-xl">
        <span class="material-symbols-outlined text-[36px]" aria-hidden="true">play_arrow</span>
      </span>
    </button>
  </div>

  <div class="flex flex-col gap-2 pt-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="font-label-sm text-label-sm text-on-surface-variant">Video demo · Datos de ejemplo</p>
    <a href="#demo" data-close-video-link class="font-label-sm text-label-sm font-semibold text-primary underline underline-offset-2">
      ¿Prefieres una demo en vivo? Agenda aquí
    </a>
  </div>

  <p id="video-fallback" class="hidden rounded-lg bg-surface-container px-4 py-3 font-body-sm text-body-sm text-on-surface-variant">
    El video aún no está disponible.
    <a href="#demo" data-close-video-link class="font-semibold text-primary underline underline-offset-2">Agenda una demo en vivo</a>.
  </p>
</dialog>

<script>
  import "../scripts/video";
</script>
